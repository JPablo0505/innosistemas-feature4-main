package com.udea.innosistemas;

import org.junit.jupiter.api.Test;
import org.springframework.boot.test.context.SpringBootTest;
import static org.junit.jupiter.api.Assertions.*;

@SpringBootTest
public class InnoSistemasApplicationTest {

    @Test
    public void contextLoads() {
        assertDoesNotThrow(() -> InnoSistemasApplication.main(new String[] {}));
    }

    @Test
    public void systemPropertiesShouldBeConfigured() {
        InnoSistemasApplication.main(new String[] {});
        
        assertNotNull(System.getProperty("user.timezone"));
        assertNotNull(System.getProperty("file.encoding"));
        assertNotNull(System.getProperty("java.awt.headless"));
    }

    @Test
    public void applicationShouldInitializeSuccessfully() {
        assertNotNull(InnoSistemasApplication.class);
    }
}
